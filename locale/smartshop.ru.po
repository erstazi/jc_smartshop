msgid "for sale:"
msgstr "на продажу:"

msgid "price:"
msgstr "цена:"

msgid "customer view"
msgstr "вид для покупателя"

msgid "view the shop as a customer"
msgstr "просмотреть магазин как покупатель"

msgid "strict meta?"
msgstr "строгие метаданные?"

msgid "check this if you are buying or selling items with unique properties like written books or petz."
msgstr "Отметьте, если вы покупаете или продаёте предметы с уникальными свойствами, например письменные книги или питомцев."

msgid "private?"
msgstr "личный?"

msgid "uncheck this if you want to share control of the shop with anyone in the protected area."
msgstr "Снимите отметку, если хотите разрешить другим игрокам в защищённой области управлять магазином."

msgid "freebies?"
msgstr "бесплатно?"

msgid "check this if you want to be able to give/receive items without an exchange"
msgstr "Отметьте, если хотите иметь возможность передавать или получать предметы без обмена"

msgid "unlimited?"
msgstr "безлимитный?"

msgid "check this allow exchanges ex nihilo. shop contents will be ignored"
msgstr "Отметьте, чтобы разрешить обмены ex nihilo. содержимое магазина будет игнорироваться"

msgid "purchase history"
msgstr "история покупок"

msgid "view a log of purchases from the shop"
msgstr "просмотреть журнал покупок в магазине"

msgid "Stock is unlimited"
msgstr "Товар неограничен"

msgid "refill"
msgstr "пополнить"

msgid "send"
msgstr "отправить"

msgid "payments sent to @1"
msgstr "платежи отправляются в @1"

msgid "click to set send storage"
msgstr "нажмите, чтобы установить хранилище для отправки"

msgid "automatically refilled from @1"
msgstr "автоматически пополняется из @1"

msgid "click to set refill storage"
msgstr "нажмите, чтобы установить хранилище для пополнения"

msgid "used with connected smartshops"
msgstr "используется с подключёнными умными магазинами"

msgid "save"
msgstr "сохранить"

msgid "Private?"
msgstr "Личный?"

msgid "uncheck this if you want to share control of the storage with anyone in the protected area."
msgstr "Снимите отметку, если хотите разрешить другим игрокам в защищённой области управлять хранилищем."

msgid "close history"
msgstr "закрыть историю"

msgid "@1 @2 bought @3 for @4"
msgstr "@1 @2 купил(а) @3 за @4"

msgid "Smartshop"
msgstr "Минимагазин"

msgid "Smartshop external storage"
msgstr "Дополнительное хранилище для минимагазина"

msgid "Shop by: @1"
msgstr "Магазин принадлежит: @1"

msgid "(Smartshop by @1)"
msgstr "(Магазин принадлежит: @1)"

msgid "This shop is over-full."
msgstr "Этот магазин переполнен."

msgid "This shop is sold out."
msgstr "Этот магазин распродан."

msgid "This shop is not configured."
msgstr "Этот магазин не настроен."

msgid "External storage by: @1"
msgstr "Дополнительное хранилище принадлежит: @1"

msgid "Storage link attempt timed out, please try again."
msgstr "Время ожидания связи с хранилищем истекло. Пожалуйста, попробуйте ещё раз."

msgid "Punch a smartshop storage node to link @1 storage"
msgstr "Нажмите на узел хранилища Smartshop, чтобы связать хранилище @1"

msgid "You do not own this storage!"
msgstr "У вас нет прав на это хранилище!"

msgid "Storage is too far from shop to link!"
msgstr "Хранилище находится слишком далеко от магазина для установки связи!"

msgid "@1 storage linked!"
msgstr "Хранилище @1 подключено!"

msgid "normal exchange"
msgstr "обычный обмен"

msgid "Cannot exchange: You lack appropriate payment"
msgstr "Невозможно обменять: у вас нет подходящей оплаты"

msgid "Cannot exchange: Shop is sold out"
msgstr "Невозможно обменять: магазин распродан"

msgid "Cannot exchange: No room in your inventory"
msgstr "Невозможно обменять: в вашем инвентаре нет места"

msgid "Cannot exchange: Shop is full"
msgstr "Невозможно обменять: магазин заполнен"

msgid "Cannot exchange: Failed for unknown reason"
msgstr "Невозможно обменять: неизвестная ошибка"